    {
      "name": "08 - Detect Upload Image",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains detections array\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response.detections).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"AI detected fire\", function () {\r\n    const response = pm.response.json();\r\n\r\n    const fireDetected = response.detections.some(\r\n        item => item.class_name === \"fire\"\r\n    );\r\n\r\n    pm.expect(fireDetected).to.be.true;\r\n});\r\n\r\npm.test(\"Fire confidence >= 0.45\", function () {\r\n    const response = pm.response.json();\r\n\r\n    const fire = response.detections.find(\r\n        item => item.class_name === \"fire\"\r\n    );\r\n\r\n    pm.expect(fire).to.exist;\r\n    pm.expect(fire.confidence).to.be.at.least(0.45);\r\n});\r\n"
            ]
          }
        }
      ],
